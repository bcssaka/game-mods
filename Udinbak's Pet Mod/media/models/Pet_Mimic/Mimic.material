			scene_blend add
			ambient 0 0 0
			diffuse 0 0 0
			emissive 0 0 0
			texture_unit
			{
				cubic_texture envmap.dds combinedUVW
				env_map cubic_reflection
				env_map tex_address_mode clamp
			}
			texture_unit
			{
				texture gold_spec.png
				colour_op_ex modulate src_texture src_current
			}
		}
	}
}
material 09_-_Default
{
	technique
	{
		pass
		{
			ambient 0.588235 0.588235 0.588235
			diffuse 0.588235 0.588235 0.588235
			specular 0 0 0 0
			emissive 0 0 0
			scene_blend alpha_blend
			alpha_rejection greater 128
			texture_unit
			{
				texture mimic.png
			}
		}
	}
}
