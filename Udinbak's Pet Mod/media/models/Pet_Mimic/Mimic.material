material Material_#11/chest_rare
{
	technique
	{
		pass
		{
			ambient 0.588 0.588 0.588
			diffuse 0.588 0.588 0.588
			specular 0 0 0 0
			emissive 0 0 0
			texture_unit
			{
				texture chest_rare.png
			}
		}
		pass
		{
			lighting off
			scene_blend add
			ambient 0 0 0
			diffuse 0 0 0
			emissive 0 0 0
			texture_unit
			{
				cubic_texture envmap.dds combinedUVW
				env_map cubic_reflection
				env_map tex_address_mode clamp
			}
			texture_unit
			{
				texture chest_rare_spec.png
				colour_op_ex modulate src_texture src_current
			}
		}
	}
}
